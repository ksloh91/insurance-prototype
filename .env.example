# Copy to .env and fill in before deployment

# Formspree form endpoint (free tier: 50 submissions/month)
NUXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Google Analytics 4 measurement ID (optional)
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Meta Pixel ID (optional)
NUXT_PUBLIC_META_PIXEL_ID=123456789012345

# WhatsApp number in international format without + or spaces
NUXT_PUBLIC_WHATSAPP_NUMBER=60123456789
